# App OAuth de 42 (créala en https://profile.intra.42.fr/oauth/applications)
# Redirect URI que hay que registrar en la app: http://localhost:5173/api/auth/callback
# Scopes que la app debe tener activados: public, projects (slots y correcciones)
# y profile (apuntarse y borrarse de eventos).
# Sin estas dos variables no se puede iniciar sesión con la intra; la web ofrece
# un "modo demo" con datos de ejemplo.
FT_CLIENT_ID=
FT_CLIENT_SECRET=
FT_REDIRECT_URI=http://localhost:5173/api/auth/callback

# Campus por defecto si el usuario no tiene campus principal (22 = 42 Madrid)
FT_CAMPUS_ID=22

# Límite horario de llamadas de la API de 42 por aplicación. Cerca del límite,
# la caché deja de renovar y sirve lo que tiene.
# FT_HOURLY_LIMIT=1200

# URL del frontend (a donde volver tras el login) y puerto del servidor de la API
APP_URL=http://localhost:5173
PORT=3112

# Docker (make start). PUBLIC_PORT es el puerto del host (el contenedor escucha
# siempre en el 3000) y PUBLIC_URL la dirección con la que entra el navegador:
# detrás de un proxy con dominio, el https del dominio. A ella vuelve el login
# de la intra, así que registra <PUBLIC_URL>/api/auth/callback como redirect
# URI en la app OAuth. Por defecto, puerto 3000 y http://localhost:<PUBLIC_PORT>.
# PUBLIC_PORT=8123
# PUBLIC_URL=https://calendar42.ejemplo.com
